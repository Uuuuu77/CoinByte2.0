# Backend runtime
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/coinbyte
JWT_SECRET_KEY=replace-with-a-random-32-byte-secret

# External market data
COINGECKO_API_BASE_URL=https://api.coingecko.com/api/v3

# Payments, required only when payment routes are enabled
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Email, required only when email delivery is enabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
EMAIL=
EMAIL_PASSWORD=

# Frontend
REACT_APP_API_BASE_URL=http://localhost:5000/api
